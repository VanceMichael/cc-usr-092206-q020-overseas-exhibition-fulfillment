      { "op": "minute.record", "meeting": "meetingPaw", "summary": "PawMart 为巴生谷 12 家门店采购，首批试单关注冻干猫粮保质期与清真认证；我方承诺提供 JAKIM 认证进度说明。", "nextSteps": ["9月18日前反馈样品测试结果", "我方9月15日前提供清真认证时间表", "测试通过后出具 14 天有效报价"] },

      { "op": "demand.record", "at": "2026-09-11T10:55:00+08:00", "buyer": "pawB", "ref": "demandPaw", "categories": ["宠物食品"], "quantity": 3000, "budget": "MYR 90000", "note": "要求 10 月中旬前到仓" },
      { "op": "demand.record", "at": "2026-09-11T16:20:00+08:00", "buyer": "jincheng", "ref": "demandJincheng", "categories": ["宠物玩具"], "quantity": 10000, "budget": "MYR 60000" },

      { "op": "livestream.authorize", "at": "2026-09-11T09:00:00+08:00", "exhibitor": "mengzhua", "partner": "nanyang", "scope": "2026 秋季新品发布会片段，仅限马来西亚境内社媒账号", "contents": ["冻干猫粮新品直播切片", "逗猫棒现场演示切片"], "ref": "liveNanyang" },
