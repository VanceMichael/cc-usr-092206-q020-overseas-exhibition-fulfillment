      { "op": "quote.accept", "at": "2026-09-14T09:30:00+08:00", "quote": "quotePaw", "ref": "orderPaw" },
      { "op": "order.split", "at": "2026-09-14T10:00:00+08:00", "order": "orderPaw", "reason": "买方要求按巴生港清关与门店上架档期分两批发货", "children": [
        { "ref": "orderAir", "label": "空运急单（首批 800 罐先行上架）", "items": [{ "name": "萌爪冻干猫粮（鸡肉味）", "quantity": 800 }] },
        { "ref": "orderSea", "label": "海运整柜（余量 2200 罐）", "items": [{ "name": "萌爪冻干猫粮（鸡肉味）", "quantity": 2200 }] }
      ] },
      { "op": "order.fulfill", "at": "2026-09-20T14:00:00+08:00", "order": "orderAir", "itemIndex": 0, "quantity": 800 },
      { "op": "order.fulfill", "at": "2026-09-24T14:00:00+08:00", "order": "orderSea", "itemIndex": 0, "quantity": 1000 },

      { "op": "cooperation.terminate", "at": "2026-09-15T11:00:00+08:00", "partyA": "mengzhua", "partyB": "jinshi", "reason": "双方在清洁品类年度返点与最低起订量上未能达成一致，本届终止对接" }
    ]
