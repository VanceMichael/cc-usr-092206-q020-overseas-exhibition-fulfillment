      { "op": "quote.issue", "at": "2026-09-11T16:30:00+08:00", "exhibitor": "mengzhua", "buyer": "jincheng", "ref": "quoteJincheng", "items": [{ "name": "逗猫棒替换头套装", "quantity": 10000, "unitPrice": 5.2 }], "currency": "MYR", "validDays": 1 },

      { "op": "quote.issue", "at": "2026-09-12T11:00:00+08:00", "exhibitor": "mengzhua", "buyer": "pawB", "ref": "quotePaw", "items": [{ "name": "萌爪冻干猫粮（鸡肉味）", "quantity": 3000, "unitPrice": 27.5 }], "currency": "MYR", "validDays": 14 },
      { "op": "buyer.merge", "at": "2026-09-13T10:00:00+08:00", "primary": "pawA", "duplicate": "pawB", "reason": "两张名片的公司邮箱、公司名与采购品类一致，确认为 PawMart 同一采购负责人" },
      { "op": "consent.grant", "at": "2026-09-13T10:10:00+08:00", "from": "pawA", "to": "mengzhua", "purpose": "样品与订单跟进", "ref": "consentPaw" },
