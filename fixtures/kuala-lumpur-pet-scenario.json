      { "op": "party.register", "ref": "miaoxiang", "kind": "exhibitor", "name": "喵享智能宠物科技", "country": "中国", "categories": ["宠物食品"], "contact": { "channel": "email", "value": "sales@miaoxiang.example.test" } },

      { "op": "qualification.submit", "exhibitor": "mengzhua", "documents": ["营业执照", "宠物食品出口备案", "产品检测报告"] },
      { "op": "qualification.review", "at": "2026-08-22T10:00:00+08:00", "exhibitor": "mengzhua", "approve": true },
      { "op": "qualification.submit", "at": "2026-08-20T10:00:00+08:00", "exhibitor": "miaoxiang", "documents": ["营业执照"] },
      { "op": "qualification.review", "at": "2026-08-23T10:00:00+08:00", "exhibitor": "miaoxiang", "approve": false, "reason": "缺少马来西亚兽医局要求的宠物食品进口准证备案" },

