      { "op": "exhibit.register", "at": "2026-09-01T10:00:00+08:00", "exhibitor": "mengzhua", "ref": "freezeDried", "name": "萌爪冻干猫粮（鸡肉味）", "category": "宠物食品" },
      { "op": "exhibit.register", "at": "2026-09-01T10:00:00+08:00", "exhibitor": "mengzhua", "ref": "teaser", "name": "逗猫棒替换头套装", "category": "宠物玩具" },
      { "op": "exhibit.register", "at": "2026-09-01T10:00:00+08:00", "exhibitor": "mengzhua", "ref": "foamSpray", "name": "宠物免洗清洁喷雾", "category": "宠物清洁" },
      { "op": "exhibit.swap", "at": "2026-09-09T16:00:00+08:00", "exhibit": "mengzhua", "exhibit": "foamSpray", "replacement": { "ref": "wipes", "name": "宠物可降解清洁湿巾", "category": "宠物清洁" }, "reason": "航司将加压喷雾罐列为限运品，原展品无法随机抵达，改用同类别湿巾替补" },

