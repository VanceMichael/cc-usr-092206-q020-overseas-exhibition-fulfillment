      { "op": "sample.review", "at": "2026-09-05T14:00:00+08:00", "sample": "sampleToy", "approve": false, "reason": "须补充羽毛配件的成分与安全检测报告，暂不予清关" },

      { "op": "booth.assign", "at": "2026-08-20T09:00:00+08:00", "exhibitor": "mengzhua", "hall": "B 馆", "boothNo": "B-218", "start": "2026-09-10T09:00:00+08:00", "end": "2026-09-12T18:00:00+08:00" },
      { "op": "event.schedule", "at": "2026-08-26T09:00:00+08:00", "exhibitor": "mengzhua", "title": "萌爪冻干系列新品发布会", "start": "2026-09-11T11:00:00+08:00", "end": "2026-09-11T12:00:00+08:00" },

      { "op": "party.register", "at": "2026-09-10T10:00:00+08:00", "ref": "chen", "kind": "buyer", "name": "陈女士（吉隆坡个人养宠用户）", "country": "马来西亚", "contact": { "channel": "whatsapp", "value": "+60-0000-0001" } },
      { "op": "party.register", "at": "2026-09-10T11:00:00+08:00", "ref": "pawA", "kind": "buyer", "name": "PawMart 采购部 王先生", "country": "马来西亚", "contact": { "channel": "email", "value": "buyer@pawmart.example.test" } },
      { "op": "party.register", "at": "2026-09-11T15:00:00+08:00", "ref": "pawB", "kind": "buyer", "name": "王先生 PawMart（第二张名片）", "country": "马来西亚", "contact": { "channel": "whatsapp", "value": "+60-0000-0002" } },
      { "op": "party.register", "at": "2026-09-11T16:00:00+08:00", "ref": "jincheng", "kind": "buyer", "name": "金城宠物批发", "country": "马来西亚", "contact": { "channel": "email", "value": "trade@jincheng.example.test" } },

