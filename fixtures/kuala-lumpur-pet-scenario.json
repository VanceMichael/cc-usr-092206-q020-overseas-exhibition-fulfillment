      { "op": "lead.record", "at": "2026-09-10T11:10:00+08:00", "exhibitor": "mengzhua", "buyer": "pawA", "intent": "browsing", "note": "对冻干猫粮有采购意向，等待样品测试安排", "ref": "leadPawA" },
      { "op": "lead.record", "at": "2026-09-11T15:05:00+08:00", "exhibitor": "mengzhua", "buyer": "pawB", "intent": "sample_testing", "note": "同一位采购第二天再来展位，用英文名片再次登记", "ref": "leadPawB" },
      { "op": "lead.record", "at": "2026-09-11T16:10:00+08:00", "exhibitor": "mengzhua", "buyer": "jincheng", "intent": "channel_interest", "note": "本地批发商，愿意在马来西亚承接整柜订单", "ref": "leadJincheng" },

      { "op": "sample.ship", "at": "2026-09-11T10:00:00+08:00", "sample": "sampleFood", "buyer": "pawA", "ref": "shipPaw" },
